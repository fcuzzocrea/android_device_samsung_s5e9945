    chown system radio /sys/class/power_supply/battery/vk_key_status
    chown system radio /sys/class/power_supply/battery/batt_auth_support

    # Permission for Power Management
    write /sys/power/pm_debug_messages 1

    # block layer
    chown root system /sys/kernel/blk_sec_wb/enable_ms
    chmod 0664 /sys/kernel/blk_sec_wb/enable_ms

    # UFS
    chown system system /sys/class/scsi_host/host0/unique_number
    chown system system /sys/block/sda/device/model
    chown system system /sys/block/sda/device/rev
    chown system system /sys/class/scsi_host/host0/lt
    chown system system /sys/class/scsi_host/host0/lc
