    chmod 0664 /sys/class/usb_notify/usb_control/whitelist_for_mdm
    chown system usb /sys/class/usb_notify/usb_control/usb_sl
    chmod 0664 /sys/class/usb_notify/usb_control/usb_sl

    # ccic UVDM permission
    chown system usb /dev/ccic_misc
    chmod 0664 /dev/ccic_misc

    # set file permission for boot
    chown radio system /efs/usb_hw_param
    chmod 771 /efs/usb_hw_param
    chown system system /efs/usb_hw_param/usb_hw_param.log
    chmod 0660 /efs/usb_hw_param/usb_hw_param.log

    # SDHMS Slowdown : Cpuset
    mkdir /dev/cpuset/abnormal
    copy /dev/cpuset/cpus /dev/cpuset/abnormal/cpus
    copy /dev/cpuset/mems /dev/cpuset/abnormal/mems

    chown system system /dev/cpuset/abnormal
    chown system system /dev/cpuset/abnormal/tasks
    chown system system /dev/cpuset/abnormal/cpus
    chown system system /dev/cpuset/abnormal/cgroup.procs
    chmod 0664 /dev/cpuset/abnormal/tasks
    chmod 0664 /dev/cpuset/abnormal/cpus
    chmod 0664 /dev/cpuset/abnormal/cgroup.procs

    write /dev/cpuset/abnormal/cpus 0-3
    write /dev/cpuset/moderate/cpus 0-3

on early-fs
    write /sys/block/sda/queue/scheduler bfq
    write /sys/block/sdb/queue/scheduler bfq
    write /sys/block/sdc/queue/scheduler bfq
    write /sys/block/sdd/queue/scheduler bfq
    write /sys/block/sde/queue/scheduler bfq
    write /sys/block/sdf/queue/scheduler bfq
    write /sys/block/sdg/queue/scheduler bfq
    write /sys/block/sdh/queue/scheduler bfq
    write /sys/class/block/mmcblk0/queue/scheduler bfq
    write /sys/class/block/mmcblk1/queue/scheduler bfq

    # blkio cgroup
    mkdir /dev/blkio/top
    mkdir /dev/blkio/high
    mkdir /dev/blkio/normal
    mkdir /dev/blkio/low
    chown system system /dev/blkio/top
    chown system system /dev/blkio/high
    chown system system /dev/blkio/normal
    chown system system /dev/blkio/low
    chown system system /dev/blkio/top/tasks
    chown system system /dev/blkio/high/tasks
    chown system system /dev/blkio/normal/tasks
    chown system system /dev/blkio/low/tasks
    chown system system /dev/blkio/top/cgroup.procs
    chown system system /dev/blkio/high/cgroup.procs
    chown system system /dev/blkio/normal/cgroup.procs
    chown system system /dev/blkio/low/cgroup.procs
    chown system system /dev/blkio/top/blkio.ssg.boost_on
    chown system system /dev/blkio/high/blkio.ssg.boost_on
    chown system system /dev/blkio/normal/blkio.ssg.boost_on
    chown system system /dev/blkio/low/blkio.ssg.boost_on
    chown system system /dev/blkio/top/blkio.ssg.max_available_ratio
    chown system system /dev/blkio/high/blkio.ssg.max_available_ratio
    chown system system /dev/blkio/normal/blkio.ssg.max_available_ratio
    chown system system /dev/blkio/low/blkio.ssg.max_available_ratio
    chmod 0664 /dev/blkio/top/tasks
    chmod 0664 /dev/blkio/high/tasks
    chmod 0664 /dev/blkio/normal/tasks
    chmod 0664 /dev/blkio/low/tasks
    chmod 0664 /dev/blkio/top/cgroup.procs
    chmod 0664 /dev/blkio/high/cgroup.procs
    chmod 0664 /dev/blkio/normal/cgroup.procs
    chmod 0664 /dev/blkio/low/cgroup.procs
    chmod 0664 /dev/blkio/top/blkio.ssg.boost_on
    chmod 0664 /dev/blkio/high/blkio.ssg.boost_on
    chmod 0664 /dev/blkio/normal/blkio.ssg.boost_on
    chmod 0664 /dev/blkio/low/blkio.ssg.boost_on
    chmod 0664 /dev/blkio/top/blkio.ssg.max_available_ratio
    chmod 0664 /dev/blkio/high/blkio.ssg.max_available_ratio
    chmod 0664 /dev/blkio/normal/blkio.ssg.max_available_ratio
    chmod 0664 /dev/blkio/low/blkio.ssg.max_available_ratio

    write /dev/blkio/top/blkio.ssg.boost_on 1
    write /dev/blkio/high/blkio.ssg.max_available_ratio 90
    write /dev/blkio/normal/blkio.ssg.max_available_ratio 60
    write /dev/blkio/low/blkio.ssg.max_available_ratio 30

on late-fs
    start bootanim
    class_start animation
    wait_for_prop hwservicemanager.ready true
    mount_all /vendor/etc/fstab.${ro.hardware} --late
    swapon_all /vendor/etc/fstab.${ro.hardware}
    
on fs
    start hwservicemanager
    mount_all /vendor/etc/fstab.${ro.hardware} --early

    start insmod_sh_system

    wait /dev/block/by-name/sec_efs
    mount ext4 /dev/block/by-name/sec_efs /efs nosuid nodev noatime noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic

    setprop ro.crypto.fuse_sdcard true

    restorecon_recursive /mnt/vendor/efs
    restorecon_recursive /mnt/vendor/cpefs
    restorecon_recursive /mnt/vendor/persist

    chown radio system /mnt/vendor/efs
    chmod 0771 /mnt/vendor/efs
    chown radio system /mnt/vendor/cpefs
    chmod 0771 /mnt/vendor/cpefs
    chown radio system /mnt/vendor/persist

    mkdir /mnt/vendor/persist/data/sfs 0700 system system
    mkdir /mnt/vendor/persist/data/tz 0700 system system

    # Permissions Camera
