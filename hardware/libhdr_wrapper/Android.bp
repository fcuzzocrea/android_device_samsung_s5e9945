cc_library_shared {
    name: "libhdr_wrapper",
    srcs: ["HdrInterfaceWrapper.cpp"],
    local_include_dirs: ["."],
    export_include_dirs: ["."],
    vendor: true,                      // match libexynosdisplay partition
    shared_libs: [
        "libdl",
        "libbase",                     // or "liblog" if you use ALOG*
    ],
    header_libs: [
        "libsystem_headers",
        "libhdrinterface_header_s5e9945",
        "libhdr10p_meta_interface_header",
    ],
    cflags: ["-Wno-unused-parameter"],
    include_dirs: ["hardware/samsung_slsi-linaro/exynos/include"],
}

