cc_library_shared {
    name: "libhdr_wrapper",
    srcs: ["HdrInterfaceWrapper.cpp"],
    local_include_dirs: ["."],
    export_include_dirs: ["."],
    vendor: true,
    shared_libs: [
        "libdl",
        "liblog",
        "libutils",
    ],
    header_libs: [
        "libsystem_headers",
        "libhdrinterface_header_default",
        "libhdr10p_meta_interface_header",
    ],
    cflags: ["-Wno-unused-parameter", "-DLOG_TAG=\"libhdr_wrapper\"",],
    include_dirs: ["hardware/samsung_slsi-linaro/exynos/include"],
}
